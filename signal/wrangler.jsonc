// Cloudflare Worker for co-op signalling (src/index.ts). Deploy steps: docs/WORKFLOW.md section 4.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opencraft-signal",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  // SQLite-backed Durable Objects are the kind the Workers Free plan offers.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "vars": {
    // Pages allowed to call the Worker from a browser, besides localhost.
    "ALLOWED_ORIGINS": "https://sidem.github.io"
  }
}
